{
  "manifest_version": 3,
  "name": "UnmixAudio — BPM, Key & Stem Separator",
  "version": "1.0.0",
  "description": "Real-time BPM & Key detection + AI stem separation for music producers.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "storage",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UnmixAudio"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio-worklet-processor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
