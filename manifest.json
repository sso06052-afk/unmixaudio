{
  "manifest_version": 3,
  "name": "UnmixAudio — Music Analyzer & Recorder",
  "version": "1.0.0",
  "description": "Real-time BPM & Key detection (local) with source separation and audio export for music producers and DJs.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "storage",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://unmixaudio-production.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UnmixAudio"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' https://cdn.jsdelivr.net 'unsafe-eval' 'wasm-unsafe-eval';"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["audio-worklet-processor.js", "privacy-policy.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
